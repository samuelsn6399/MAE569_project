%% Optimize Jupiter 2 Earth Arrival + Depart Dates
clear;clc;
%% Constants and Conversions
AUTU2kms = 29.784852; % [(km/s)/(AU/TU)]
TU2day = 58.132821; % [day/TU]
TU2s = 5.023e6; % [s/TU]
s2TU = 1/TU2s; % [TU/s]
min2TU = s2TU*60; % [TU/min]
hr2TU = min2TU*60; % [TU/hr]
day2TU = hr2TU*24; % [TU/day]

%% Set Departure Date
jupiter_dDate1 = datetime(2050,04,12,11,58,00);

%% Initialize Iterative Variables
% Vary ToF; fix depart date
ToF12_dayidx = 700:1000; % [day]
deltaV_ToF = zeros(1,length(ToF12_dayidx));
deltaV1_ToF = zeros(1,length(ToF12_dayidx));
deltaV2_ToF = zeros(1,length(ToF12_dayidx));
deltaV3_ToF = zeros(1,length(ToF12_dayidx));

%%  Iterate on ToF To Flyby W/ Hohmman Transfer post fly-by
for i=1:length(ToF12_dayidx)
    [deltaV_ToF(i),deltaV1_ToF(i),deltaV2_ToF(i),deltaV3_ToF(i)] = Jupiter2EarthV3_func(jupiter_dDate1, ToF12_dayidx(i));
    fprintf('Scenario: 1/2 | iteration: %3d/%3d |\n',i,length(ToF12_dayidx))
end
figure(2);clf(2);
plot(ToF12_dayidx,deltaV_ToF)
xlabel('ToF [days]','Interpreter','latex')
ylabel('$\deltaV$ [km/s]','Interpreter','latex')
title('Sensitivity Analysis: Time of Flight From Jupiter to Earth Flyby')

%% Set Time of Flight
ToF12_day = 810; % [day]

%% Initialize Iterative Variables
% Vary Depart Day; fix ToF
dDate1 = 0:1:365;
jupiter_dDate1_idx = jupiter_dDate1+dDate1;
deltaV_depart = zeros(1,length(jupiter_dDate1_idx));
deltaV1_depart = zeros(1,length(jupiter_dDate1_idx));
deltaV2_depart = zeros(1,length(jupiter_dDate1_idx));
deltaV3_depart = zeros(1,length(jupiter_dDate1_idx));
dDate1 = 0:1:365;
jupiter_dDate1_idx = jupiter_dDate1+dDate1;

%%  Iterate on ToF To Flyby W/ Hohmman Transfer post fly-by
for i=1:length(jupiter_dDate1_idx)
    [deltaV_depart(i),deltaV1_depart(i),deltaV2_depart(i),deltaV3_depart(i)] = Jupiter2EarthV3_func(jupiter_dDate1_idx(i), ToF12_day);
    fprintf('Scenario: 2/2 | iteration: %3d/%3d |\n',i,length(jupiter_dDate1_idx))
end
figure(3);clf(3);
plot(jupiter_dDate1_idx,deltaV_depart)
xlabel('Date of Departure [day-month-year]','Interpreter','latex')
ylabel('$\deltaV$ [km/s]','Interpreter','latex')
title('Sensitivity Analysis: Date of Departure')
